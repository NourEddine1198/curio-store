generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Products ───────────────────────────────────────────────
model Product {
  id          String      @id @default(cuid())
  slug        String      @unique           // "goul-bla-matgoul", "roubla"
  name        String                        // Arabic display name
  nameEn      String?                       // English name (for admin)
  description String?     @db.Text
  price       Int                           // Price in DA (centimes-free)
  compareAt   Int?                          // Strike-through price for bundles
  images      String[]                      // Array of image URLs
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]
}

// ─── Orders ─────────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  status          OrderStatus @default(PENDING)
  // The status an order held before it was archived as HANDLED. The console
  // shows one flat "handled" label for the pre-waitlist era, but the owner
  // dashboard still reads the real outcome from here, so archiving does not
  // erase delivered/returned revenue. Null for everything else.
  preHandledStatus OrderStatus?

  // Customer info
  customerName    String
  customerPhone   String
  customerPhone2  String?                   // Backup phone

  // Delivery info
  wilayaCode      String                    // "16" for Algiers
  wilayaName      String                    // "الجزائر"
  deliveryType    DeliveryType              // HOME or OFFICE
  commune         String?                   // Chosen baladiya (Ecotrack commune name) — for HOME delivery
  address         String?     @db.Text      // Home address (if HOME)
  officeName      String?                   // Stop-desk station name (if OFFICE)
  officeCommune   String?                   // Stop-desk commune (Ecotrack commune name, if OFFICE)
  deliveryPrice   Int         @default(0)   // Delivery cost in DA

  // Money
  subtotal        Int                       // Products total in DA
  total           Int                       // subtotal + deliveryPrice

  // Fulfillment
  confirmedAt     DateTime?                 // When confirmation agent confirmed
  confirmedBy     String?                   // Agent name/username who confirmed

  // ── In-house confirmation workflow (own agents; replaces OrderDZ) ──
  assignedAgentId String?                   // which agent owns this order
  assignedAgent   Agent?      @relation("AgentOrders", fields: [assignedAgentId], references: [id])
  disposition     String?                   // confirmed | no_answer | postponed | cancelled | wrong_number | duplicate
  callAttempts    Int         @default(0)   // how many times the agent called
  lastCallAt      DateTime?
  nextCallAt      DateTime?                  // when to try again (retry scheduling / callback date)
  callbackNote    String?                    // what the client asked ("call me after 6pm")
  cancelReason    String?                    // why it was cancelled (from the reasons list or free text)

  shippedAt       DateTime?
  // Set when a box was handed to our own delivery guy instead of the courier.
  // It needs to be a real column, not a note we grep: the profit view reads
  // revenue from Ecotrack parcels, and a hand-delivered order has no parcel —
  // so without this the sale counts ZERO revenue while the cash quietly
  // arrives. This is the flag that lets the engine find them.
  // Set the evening we hand the box to our own driver, cleared only when the
  // order resolves. While it is set the order is OUT OF THE BUILDING — that is
  // what stops it also being confirmed and sent to Ecotrack the same night,
  // which is how a customer ends up with two boxes.
  handedToDriverAt DateTime?
  // How many evenings he has come back still holding it. Nobody home means he
  // keeps it and tries again tomorrow, so a box can ride several runs.
  driverAttempts  Int       @default(0)
  handDeliveredAt DateTime?
  // What the driver was paid for THIS box. Per order, not per batch: the
  // default is 350 but a far commune or an awkward drop is worth more, and a
  // single rate would quietly under-pay him or over-charge the profit.
  handDeliveryFee Int?
  trackingCode    String?                   // Shipping company tracking
  deliveredAt     DateTime?
  returnedAt      DateTime?
  returnReason    String?

  // Webhook / external
  externalId      String?                   // ID from confirmation company
  webhookPayload  Json?                     // Raw webhook data for debugging

  // Security / anti-abuse
  ip              String?                   // Client IP for rate limiting

  // Coupon / influencer attribution (structured — notes keep the human-readable copy)
  couponCode      String?                   // normalized UPPERCASE code used at checkout
  couponDiscount  Int         @default(0)   // DA taken off by that code

  // ─── Where this order came from ─────────────────────────────
  // Read from the URL on the visitor's FIRST page of the visit and held in
  // sessionStorage until checkout, so someone who lands on /roubla/ and
  // wanders to /dlala/ before ordering still credits the ad that brought them.
  // Null for everyone who arrived untagged — organic, direct, the WhatsApp
  // blast — and that absence is itself the signal: before this existed, ads,
  // blast and organic could only be told apart by guessing from dates.
  utmSource       String?                   // "meta"
  utmMedium       String?                   // "paid"
  utmCampaign     String?                   // "roubla-test" / Meta campaign name
  utmContent      String?                   // the Meta ad id, or a slug like "digourdi"
  referrer        String?     @db.Text      // first off-site referrer, when there is one

  // ─── Conversions API identifiers ────────────────────────────
  // Meta matches a server-sent event back to a real person using these. The
  // browser pixel drops _fbc (which ad they clicked) and _fbp (their browser)
  // as first-party cookies on curiodz.com; the store API lives on another
  // domain so they are never sent automatically — the checkout reads them and
  // posts them alongside the order, the same way it does the utm tags.
  // Without them the server event still sends, but Meta's match quality drops
  // sharply and most of the benefit is lost.
  fbc             String?                   // fb.1.<ts>.<fbclid> — the click
  fbp             String?                   // fb.1.<ts>.<random> — the browser
  userAgent       String?     @db.Text      // read from the request headers, not the client

  notes           String?     @db.Text      // Internal notes

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  events          OrderEvent[]
  parcel          ParcelTracking?

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([ip])
  @@index([assignedAgentId])
  @@index([nextCallAt])
  @@index([couponCode])
  @@index([handDeliveredAt])
  @@index([handedToDriverAt])
  @@index([utmCampaign])
  @@index([utmContent])
}

// ─── Influencer program ─────────────────────────────────────
// One row per influencer. Their personal coupon code attributes orders;
// every money term is per-influencer because every deal is negotiated:
//   customerDiscount — what the code gives the buyer (DA off)
//   commissionRate + commissionBasis — what THEY earn per counted order/unit
//   countTrigger — which orders are payable: PLACED (junk excluded) or CONFIRMED
//   fixedFee — flat amount for fixed-rate (or hybrid) deals
// shareToken powers their private read-only results page (/i/<token>).
model Influencer {
  id               String   @id @default(cuid())
  name             String
  handle           String?                      // @username
  platform         String?                      // instagram | tiktok | ...
  phone            String?
  couponCode       String   @unique             // stored UPPERCASE
  active           Boolean  @default(true)

  customerDiscount Int      @default(0)         // DA off for the customer
  applicableSlugs  String[] @default([])        // empty = valid on all products
  maxUses          Int      @default(0)         // stop accepting after N live orders (0 = unlimited) — launch/scarcity offers

  commissionRate   Int      @default(0)         // DA per counted order/unit
  commissionBasis  String   @default("ORDER")   // ORDER | UNIT (per game in the order)
  countTrigger     String   @default("CONFIRMED") // CONFIRMED | PLACED
  fixedFee         Int      @default(0)         // flat deal amount (0 = none)

  // ── Her selling link ──
  // linkSlug is the short name in curiodz.com/i/<slug> (lowercase, no spaces).
  // Optional: when empty the door also answers to the coupon code itself, so
  // a link works the moment an influencer exists. landingPath is where that
  // link drops the visitor — kept as a path, never a full URL, and checked
  // against an allowlist on write AND on read so this can never become an
  // open redirect out of curiodz.com.
  linkSlug         String?  @unique
  landingPath      String   @default("/roubla/")

  shareToken       String   @unique @default(cuid())
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments         InfluencerPayment[]
}

// Append-only payout log — "paid Sara 6,000 DA on Aug 3".
// The window computes owed vs paid from commission math minus these rows.
model InfluencerPayment {
  id           String     @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  amount       Int                              // DA
  note         String?
  paidAt       DateTime   @default(now())

  @@index([influencerId, paidAt])
}

// ─── Order timeline (the console's memory) ──────────────────
// One append-only row per thing that happens to an order:
//   kind = "status"  → a status change (status = the new one)
//   kind = "attempt" → one phone-call attempt
//   kind = "comment" → a note by the agent/owner
//   kind = "courier" → delivery info pulled from Ecotrack
//   kind = "system"  → automatic actions (auto-expire, edits, ...)
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String   @default("status")
  status    String?                       // new status when kind = "status"
  note      String?  @db.Text             // comment text / attempt note / courier detail
  actor     String                        // agent name | "system" | "ecotrack"
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([kind, createdAt])
}

// ─── Suivi cache — Ecotrack's side of a parcel's life ───────
// Phase 2 of the console. Once a parcel exists, the interesting
// facts live at Ecotrack, not here: where the box is, who is
// driving it, what the driver/station/we said about it.
//
// The cron mirrors that into this table so the agent's «فتح»
// screen opens instantly instead of waiting on Ecotrack, and so
// the Suivi board can QUERY the delivery trouble (you cannot
// filter a board on data that only exists in someone else's API).
//
// Nothing here is authoritative — it is a copy, refreshed on a
// schedule. `syncedAt` says how stale it is.
model ParcelTracking {
  id             String    @id @default(cuid())
  trackingCode   String    @unique
  orderId        String?   @unique
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status         String    @default("")   // Ecotrack's French display status
  globalStatus   String    @default("")   // livre | retour | en_process
  currentStation String?                  // where the box is sitting right now
  driverName     String?
  driverPhone    String?                  // the delivery guy — agent calls him
  stopDesk       Boolean?
  montant        Int       @default(0)    // what the courier will COLLECT
  tarifLivraison Int       @default(0)    // what Ecotrack charges to deliver
  tarifRetour    Int       @default(0)    // …and to bring it back

  // [{ date, time, status, station }] — the parcel's journey
  activity       Json      @default("[]")
  // [{ at, reason, text, station, driver, by }] — the 3-way thread
  comments       Json      @default("[]")

  // SORT KEYS AND THRESHOLDS ONLY — do not render these.
  // The PrismaNeonHttp adapter writes a Date using the PROCESS's local
  // time, so a sync run outside UTC stores them shifted by that offset
  // (verified: 12:00:00Z stored as 13:00:00 from a UTC+1 machine).
  // Netlify runs UTC so production is straight, but the screens read the
  // raw Algiers-time strings inside `activity` / `comments` instead, which
  // is both immune to this and what the agent actually wants to see.
  attemptCount   Int       @default(0)    // failed delivery attempts
  lastMoveAt     DateTime?                // last activity step
  lastCommentAt  DateTime?
  postponedTo    DateTime?                // driver rescheduled to this date

  // Why the Suivi board should surface this parcel.
  alertLevel     String    @default("ok") // ok | watch | act
  alertReason    String?                  // Darija, shown on the board row

  syncedAt       DateTime  @default(now())

  @@index([alertLevel, lastMoveAt])
  @@index([syncedAt])
}

// ─── Confirmation agents (in-house team, replaces OrderDZ) ──
model Agent {
  id           String   @id @default(cuid())
  name         String                       // display name
  username     String   @unique             // login
  passwordHash String                       // pbkdf2 hash (salt:hash)
  role         String   @default("agent")   // "agent" | "owner"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Brute-force protection (login lockout)
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?

  orders       Order[]  @relation("AgentOrders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Int                             // Price at time of order (in DA)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Wilayas (delivery zones) ───────────────────────────────
model Wilaya {
  code       String  @id                    // "01", "02", ... "58"
  name       String                         // Arabic name
  homePrice  Int                            // Home delivery price in DA
  officePrice Int                           // Office/stop-desk price in DA
  offices    Json?                          // Array of { commune, phone } objects
  active     Boolean @default(true)
}

// ─── Command Center "reads" — the AI co-founder routine output ──
// Each scheduled read (daily/weekly) is stored here. This is both the
// routine's MEMORY (it reads the last few to spot what changed) and what
// the dashboard's "Ask Claude" panel displays. Written by the routine;
// read by the dashboard + the routine. Never affects orders.
model CommandRead {
  id        String   @id @default(cuid())
  kind      String   @default("daily") // "daily" | "weekly"
  title     String                     // the headline
  content   String   @db.Text          // the full read (plain / markdown)
  metrics   Json?                      // snapshot of key numbers, for diffing next run
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// ─── Editable page content (the mini-CMS) ──────────────────
// Every editable piece of text or image on the marketing pages
// (home / roubla / dlala) is one row here. The live pages fetch
// these on load and swap them in; the admin panel writes them.
// Change a row → it's live in seconds, NO re-deploy.
model PageContent {
  id        String   @id @default(cuid())
  page      String                        // "home" | "roubla" | "dlala"
  key       String   @unique              // "roubla.hero.title"
  type      String   @default("text")     // "text" | "image"
  value     String   @db.Text             // the text, or the image URL
  label     String?                        // human label shown in the admin
  group     String?                        // admin section, e.g. "Hero", "Pricing"
  sort      Int      @default(0)           // ordering within a group
  updatedAt DateTime @updatedAt

  @@index([page])
}

// ─── Checkout failures (the "lost order" log) ──────────────
// Every time /api/orders turns a customer away, one row lands here.
// Why this exists: for five weeks in Jul-Aug 2026 the checkout rejected
// EVERY order from wilayas 01-09 (a leading-zero mismatch) and nobody
// knew, because a refused order leaves no trace anywhere — no Order row,
// no alert. It only surfaced when customers complained. This table is
// that missing trace.
//
// It stores the phone and name when the customer got that far, so these
// are not just a number on a chart — they are a call-back list.
// Writing here must NEVER block or break a checkout: all writes are
// wrapped and swallowed. Nothing reads this except the dashboard.
model CheckoutFailure {
  id         String   @id @default(cuid())
  reason     String                        // stable code: "wilaya_unavailable", "out_of_stock", ...
  message    String   @db.Text             // the Arabic text the customer actually saw
  status     Int      @default(400)        // HTTP status returned (400 | 429 | 500)
  silent     Boolean  @default(false)      // true = customer saw a FAKE success (bot traps)
  page       String?                       // referer path: "/roubla/", "/dlala/", "/"
  wilayaCode String?                       // as received, unnormalised — the tell for format bugs
  phone      String?                       // so the owner can call them back
  name       String?
  slugs      String[]                      // product slugs they were trying to buy
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([reason, createdAt])
}

// ─── Site settings (tiny key/value store) ──────────────────
// Small global flags/values, e.g. live prices or a launch switch.
model SiteSetting {
  key       String   @id                  // "homepageLive", "pack.price"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════
// FINANCE — the money-control layer (/finance)
//
// Two layers, deliberately kept apart:
//
//   THE LEDGER   — MoneyMovement. Money that actually moved between
//                  real accounts. One row per movement. Nothing here
//                  is derived; every row is a thing that happened.
//
//   THE PROFIT   — NOT stored. Computed on every read from orders,
//                  parcels and FinanceSetting. Derived numbers that
//                  live in a table go stale the day a rule changes,
//                  so none of them are written down.
//
// Why they differ: the 1.54M print run is ONE cash movement in June
// and ~385 DA against every box sold for months afterwards. A system
// that keeps only the first says June was a catastrophe; one that
// keeps only the second lets you run out of cash while showing a
// healthy profit.
//
// AMOUNTS: dinars are whole numbers (DA has no practical subunit).
// Euros are stored in CENTS so no float ever touches money.
// ════════════════════════════════════════════════════════════

// ─── The real accounts money sits in ────────────────────────
// Rows, not hard-coded constants, so a fourth account (a second
// courier, a real bank) is a form and not a migration.
model FinanceAccount {
  id       String  @id @default(cuid())
  key      String  @unique          // "cash" | "baridimob" | "bank_eur"
  name     String                   // shown in the UI
  currency String  @default("DZD")  // "DZD" | "EUR"
  sort     Int     @default(0)
  active   Boolean @default(true)

  movements     MoneyMovement[] @relation("MovementAccount")
  transfersIn   MoneyMovement[] @relation("MovementToAccount")
  payouts       CourierPayout[]
}

// ─── What a movement was for ────────────────────────────────
// Seeded from the founders' real cost list, editable after. The
// phone screen renders these as buttons, so the list IS the UI.
model FinanceCategory {
  key    String  @id                // "courier_payout", "consumables", ...
  label  String                     // English label (desk screen)
  labelAr String?                   // Darija label (phone screen)
  kind   String                     // "income" | "expense"
  bucket String  @default("other")  // cogs | shipping | marketing | people | consumables | other
  // true  = the profit view works this number out itself, from orders and
  //         parcels. Movements filed here are still real cash and still
  //         move the ledger — the profit view just ignores them, so paying
  //         the agent her month in cash cannot double-count against the
  //         80-per-delivered-order the profit view already charged.
  //         Every income category is `auto`, because revenue comes from
  //         parcels; cash arriving is a ledger fact, not a second sale.
  // false = the profit view SUMS the movements filed here. Costs nothing
  //         else knows about: a video, a roll of scotch, the ad bill.
  auto   Boolean @default(false)
  sort   Int     @default(0)
  active Boolean @default(true)

  movements MoneyMovement[]
}

// ─── THE LEDGER ─────────────────────────────────────────────
model MoneyMovement {
  id          String   @id @default(cuid())
  // When the money MOVED — not when it was typed. The two differ every
  // time something is entered a few days late, and only this one is
  // right for a monthly total.
  occurredAt  DateTime
  direction   String                    // "in" | "out" | "transfer"

  accountId   String                    // in → destination; out/transfer → source
  account     FinanceAccount @relation("MovementAccount", fields: [accountId], references: [id])
  toAccountId String?                   // transfer only → destination
  toAccount   FinanceAccount? @relation("MovementToAccount", fields: [toAccountId], references: [id])

  amount      Int                       // in the account's own currency (EUR = cents)
  currency    String   @default("DZD")  // copied at write time; the account may be renamed later

  // The reporting number. Stored rather than recomputed because the euro
  // rate on the day IS a fact — recomputing later at today's rate would
  // silently rewrite what August cost.
  amountDzd   Int
  fxRate      Int?                      // DA per €1, ×100 (28000 = 280.00). Null for dinar rows.

  categoryKey String
  category    FinanceCategory @relation(fields: [categoryKey], references: [key])

  note        String?  @db.Text
  payoutId    String?                   // set when this row is a courier payout's cash
  payout      CourierPayout? @relation(fields: [payoutId], references: [id])

  createdBy   String   @default("owner")
  createdAt   DateTime @default(now())

  @@index([occurredAt])
  @@index([accountId, occurredAt])
  @@index([categoryKey, occurredAt])
}

// ─── One «Décharge de paiement expéditeur» ──────────────────
// The courier pays in CASH, on request, and hands over a numbered
// slip. The slip's headline total is the sum of its Net column —
// already after their delivery fees — so `slipTotal` is what landed
// in the drawer, NOT what customers paid.
//
// `expectedTotal` is what we calculated from the parcels before he
// confirmed. Both are kept forever: a payout that came up short is
// only provable if the number we expected survives alongside it.
//
// `trackingCodes` is what stops double-counting. A delivered parcel
// counts toward "Ecotrack owes us" until its tracking code appears
// on some payout here.
model CourierPayout {
  id            String   @id @default(cuid())
  reference     String   @unique          // "#311959" from the slip
  collectedAt   DateTime
  parcelCount   Int?                      // what the slip claims
  slipTotal     Int                       // DA actually received
  expectedTotal Int                       // DA we calculated
  accountId     String
  account       FinanceAccount @relation(fields: [accountId], references: [id])
  trackingCodes String[]                  // parcels this payout settles
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  movements     MoneyMovement[]

  @@index([collectedAt])
}

// ─── The cost rules ─────────────────────────────────────────
// THE fix for the Command Center's settings living in one browser's
// localStorage, where two laptops disagreed and a cleared cache lost
// the lot. Both /finance and /dashboard read from here, so there is
// exactly one set of cost numbers for the business.
model FinanceSetting {
  key       String   @id                 // "wrap.roubla", "print.perGame", "fx.eurDzd"
  value     String                       // kept as text; the reader parses
  label     String?                      // human label for the settings screen
  unit      String?                      // "DA" | "DA/game" | "DA ×100"
  note      String?  @db.Text            // where the number came from
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Enums ──────────────────────────────────────────────────
enum OrderStatus {
  PENDING          // Just placed
  WAITLIST         // Ordered something we had no stock for — park until it arrives, then call
  HANDLED          // Pre-waitlist era (<= #557): dealt with outside this system. Archive label only.
  CONFIRMED        // Confirmation agent said yes
  CANCELLED        // Customer cancelled
  PROCESSING       // (legacy) being packed — treated like CONFIRMED
  SHIPPED          // Sent to Ecotrack (parcel created / in transit)
  DELIVERED        // Customer received (terminal)
  RETURNED         // Came back to us (terminal)
  // ── Confirmation working states (agent console v2) ──
  NO_ANSWER        // Called, nobody picked up (attempts counted)
  CALLBACK         // Client asked to be called at a specific time
  EXPIRED          // Auto: sat in NO_ANSWER 3 days with no new attempt (recoverable)
  WRONG            // Wrong/fake number — junk, excluded from confirm rate
  DUPLICATE        // Duplicate of another order — junk
  // ── Delivery journey states (fed by Ecotrack tracking sync) ──
  // SHIPPED means "we handed it over and the courier has not come yet".
  // IN_TRANSIT means they have accepted it and it is moving through their
  // network. Both used to be SHIPPED, which made a parcel created ten
  // minutes ago look identical to one that had crossed the country — and
  // hid two boxes the courier had never collected for ten days.
  IN_TRANSIT       // Accepted by the carrier, moving (vers hub / vers wilaya)
  OUT_FOR_DELIVERY // Courier is out with it (home delivery)
  AT_STOPDESK      // Waiting at the stop-desk for pickup
  DELIVERY_FAILED  // Courier couldn't deliver — agent should call (rescue!)
  IN_RETURN        // On its way back to us
}

enum DeliveryType {
  HOME
  OFFICE
}
